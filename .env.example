# ==============================================================================
# AgeWellRI Frontend - Environment Configuration Template
# Copy this file to .env.local (or .env) and customize for your environment.
# ==============================================================================

# Public Backend API Base URL (accessible from the browser)
NEXT_PUBLIC_API_URL="http://localhost:5173/api/v1"

# Public Frontend Application URL
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3000"

# Optional Next.js Allowed Dev Origins (comma-separated, useful for reverse proxies or tunnels like ngrok/Cloudflare)
# ALLOWED_DEV_ORIGINS="localhost:3000,http://localhost:3000"
